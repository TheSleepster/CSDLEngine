# -------------------------------------------------------------------------
# Makefile - unity build (default) or developer split (exe + dll + runtime)
# -------------------------------------------------------------------------

CXX    = clang++
CC     = clang

SILENT          ?=
DEBUG           ?=            # set DEBUG=1 to get debug compile flags (-g -O0)
DEVELOPER_BUILD ?=            # set DEVELOPER_BUILD=1 to produce exe + libGameRuntime.lib + dll

# -------------------------------------------------------------------------
# Platform detection
# -------------------------------------------------------------------------
ifeq ($(OS),Windows_NT)
    OS_DEFINE = -DOS_WINDOWS=1
    PLATFORM_LIBS = -lopengl32 -luser32 -lgdi32 -lwinmm -lshell32 -lole32 -luuid -lversion -ladvapi32 -lsetupapi -lcfgmgr32 -loleaut32 -limm32
    LDFLAGS = -Wl,/IGNORE:4099 -Wl,/STACK:157286400
    EXE_EXT = .exe
    DLL_EXT = .dll
    LIB_EXT = .lib
    OBJ_EXT = .obj
    DEV_NULL = NUL
    PIC_FLAG =
else
    UNAME_S := $(shell uname -s)
    DLL_EXT = .so
    LIB_EXT = .a
    OBJ_EXT = .o
    PIC_FLAG = -fPIC
    ifeq ($(UNAME_S),Linux)
        OS_DEFINE = -DOS_LINUX=1
        PLATFORM_LIBS = -lX11 -lGL -lm
        DEV_NULL = /dev/null
    else ifeq ($(UNAME_S),Darwin)
        OS_DEFINE = -DOS_MAC=1
        PLATFORM_LIBS = -framework Cocoa -framework OpenGL -lm
        DEV_NULL = /dev/null
    endif
endif

# -------------------------------------------------------------------------
# Common flags / includes
# -------------------------------------------------------------------------
COMMON_INCLUDE_PATHS = -I../code/ -I../run_tree/deps/ -I../run_tree/deps/stb/ -I../run_tree/deps/sokol/ -I../run_tree/deps/glad/include/ -I../run_tree/deps/SDL3/include/ -I../run_tree/deps/Freetype/include/
COMMON_C_FLAGS       = -Wall -Wextra -Wno-unused-function -Wno-unused-parameter -Wno-missing-braces -Wno-pointer-sign -Wno-incompatible-pointer-types-discards-qualifiers -Wno-null-dereference -Wno-missing-field-initializers -Wno-switch -Wno-incompatible-pointer-types -Wno-deprecated-declarations -Wno-null-pointer-subtraction -Wno-typedef-redefinition -Wno-pointer-integer-compare -Wno-writable-strings -Wno-deprecated

# Build type (kept separate so you can use BUILD_TYPE in outputs)
BUILD_TYPE ?= debug

# Choose CFLAGS based on DEBUG
ifeq ($(DEBUG),1)
    CFLAGS = -g -O0 -fno-inline-functions $(COMMON_C_FLAGS) -DINTERNAL_DEBUG=1 -DASSERT_ENABLED=1
else
    CFLAGS = -O2 $(COMMON_C_FLAGS)
endif

# -------------------------------------------------------------------------
# Sources & outputs
# -------------------------------------------------------------------------
# Unity single TU (legacy)
UNITY_SRC        = ../code/main.cpp

# Engine split (loader + minimal engine code)
ENGINE_SPLIT_SRC = ../code/main.cpp

# Game DLL source
GAME_SRC         = ../code/g_main.cpp

# Default runtime sources (edit to list your runtime .cpp files).
# If your runtime is many files, list them space-separated here.
GAME_RUNTIME_SRCS = ../code/g_runtime.cpp

# Turn runtime sources into ../build/runtime_<name>$(OBJ_EXT)
GAME_RUNTIME_OBJS := $(patsubst ../code/%.cpp,../build/runtime_%$(OBJ_EXT),$(filter ../code/%.cpp,$(GAME_RUNTIME_SRCS)))

# Path to static runtime archive (.a on POSIX, .lib on Windows)
GAME_RUNTIME_LIB  = ../build/libGameRuntime$(LIB_EXT)

# Libraries
ENGINE_LIBS = $(PLATFORM_LIBS) -L../run_tree/deps/glad/src/ -L../run_tree/deps/SDL3/lib/ -L../run_tree/deps/Freetype/ -lSDL3-Static -lglad -lfreetype
GAME_LIBS   = -L../run_tree/deps/SDL3/lib/ -L../build/ -lSDL3-Static 
# Outputs
ENGINE_OUT  = ../build/Thor_$(BUILD_TYPE)$(EXE_EXT)
GAME_OUT    = ../build/game_$(BUILD_TYPE)$(DLL_EXT)
ASSET_FILE_BUILDER_SRC = ../code/asset_builder/ab_main.c
ASSET_FILE_BUILDER_OUT = ../build/asset_file_builder$(EXE_EXT)

# Tests
TESTS_SRC  = $(wildcard ../code/tests/*.c)
TESTS_OUT  = $(patsubst ../code/tests/%.c,../build/test_%.exe,$(TESTS_SRC))
TESTS_LIBS = $(PLATFORM_LIBS)

# -------------------------------------------------------------------------
# Decide engine source depending on DEVELOPER_BUILD
# -------------------------------------------------------------------------
ifeq ($(DEVELOPER_BUILD),1)
    ENGINE_SRC = $(ENGINE_SPLIT_SRC)
else
    ENGINE_SRC = $(UNITY_SRC)
endif

# Shared flags for building a shared lib
SHARED_FLAGS = -shared

# -------------------------------------------------------------------------
# Targets
# -------------------------------------------------------------------------
.PHONY: all engine asset_file_builder game_dll game_runtime tests clean

ifeq ($(DEVELOPER_BUILD),1)
all: engine game_runtime game_dll asset_file_builder tests
else
all: engine asset_file_builder tests
endif

# Ensure build dir exists
../build:
	mkdir -p ../build

# -------------------------------------------------------------------------
# Tests pattern rule (per-test)
# -------------------------------------------------------------------------
../build/test_%.exe: ../code/tests/%.c | ../build
	@echo Building Test $(@F)... 
	$(SILENT)$(CC) $(CFLAGS) $(COMMON_INCLUDE_PATHS) $(OS_DEFINE) $< $(TESTS_LIBS) -o $@ -MMD -MF ../build/test_$(*F).d

tests: $(TESTS_OUT)

# -------------------------------------------------------------------------
# Asset file builder
# -------------------------------------------------------------------------
$(ASSET_FILE_BUILDER_OUT): $(ASSET_FILE_BUILDER_SRC) | ../build
	@echo Building Asset File Builder...
	$(SILENT)$(CC) $(CFLAGS) $(COMMON_INCLUDE_PATHS) -Wno-undefined-internal $(OS_DEFINE) $< $(PLATFORM_LIBS) -o $@ -MMD -MF ../build/asset_file_builder.d

asset_file_builder: $(ASSET_FILE_BUILDER_OUT)

# -------------------------------------------------------------------------
# Game runtime: compile .cpp -> objects, then archive into libGameRuntime.{a|lib}
# -------------------------------------------------------------------------
# Compile runtime sources to platform-appropriate objects
../build/runtime_%$(OBJ_EXT): ../code/%.cpp | ../build
# Unconditional user-friendly message: always prints (not prefixed by $(SILENT))
	$(SILENT)$(CXX) -c $(CFLAGS) $(PIC_FLAG) $(COMMON_INCLUDE_PATHS) $(OS_DEFINE) $< -o $@ -MMD -MF ../build/$(notdir $@).d

# Archive the runtime objects into a static library; use 'lib' on Windows, 'ar' on POSIX
$(GAME_RUNTIME_LIB): $(GAME_RUNTIME_OBJS) | ../build
	@echo Archiving game runtime into $@ ...
ifeq ($(OS),Windows_NT)
# lib.exe expects: lib /OUT:archive.lib obj1.obj obj2.obj
	lib /OUT:$@ $(GAME_RUNTIME_OBJS)
else
	ar rcs $@ $(GAME_RUNTIME_OBJS)
endif

# Alias target
game_runtime: $(GAME_RUNTIME_LIB)

# -------------------------------------------------------------------------
# Engine EXE
# Note: in DEVELOPER_BUILD=1 the engine must NOT include the runtime implementation.
# -------------------------------------------------------------------------
engine: $(ENGINE_OUT)

$(ENGINE_OUT): $(ENGINE_SRC) | ../build
	@echo Building Engine EXE: $@ ...
	$(SILENT)$(CXX) $(CFLAGS) $(COMMON_INCLUDE_PATHS) $(OS_DEFINE) $< $(ENGINE_LIBS) $(LDFLAGS) -o $@ -MMD -MF ../build/engine.d

# -------------------------------------------------------------------------
# Game DLL (only built when DEVELOPER_BUILD=1)
# Link the runtime static archive into the DLL so runtime is only present in the DLL.
# -------------------------------------------------------------------------
ifeq ($(DEVELOPER_BUILD),1)
game_dll: $(GAME_OUT)

$(GAME_OUT): $(GAME_SRC) $(GAME_RUNTIME_LIB) | ../build
	@echo Building Game DLL: $@ ...
# Define GAME_DLL_BUILD so your GAME_API expands to dllexport on Windows
	$(CXX) $(CFLAGS) $(COMMON_INCLUDE_PATHS) $(OS_DEFINE) -DGAME_DLL_BUILD=1 $(SHARED_FLAGS) $< $(GAME_RUNTIME_LIB) $(GAME_LIBS) $(LDFLAGS) -o $@ -MMD -MF ../build/game_dll.d
endif

# -------------------------------------------------------------------------
# Helpers
# -------------------------------------------------------------------------
run_asset_file_builder: asset_file_builder
	@echo Running Asset File Builder...
	../build/asset_file_builder$(EXE_EXT)

clean:
	rm -rf ../build

# -------------------------------------------------------------------------
# Auto deps: include generated .d files when present
# -------------------------------------------------------------------------
-include ../build/engine.d
-include ../build/asset_file_builder.d
-include ../build/game_dll.d
# runtime deps: convert runtime object names to .d by replacing OBJ_EXT with .d
GAME_RUNTIME_DEPS := $(GAME_RUNTIME_OBJS:$(OBJ_EXT)=.d)
-include $(GAME_RUNTIME_DEPS)
-include $(patsubst ../code/tests/%.c,../build/test_%.d,$(TESTS_SRC))

# -------------------------------------------------------------------------
# Usage:
#   make                      # unity single-TU, same as before
#   make DEVELOPER_BUILD=1    # split build: engine EXE + libGameRuntime.{a|lib} + game DLL
#   make DEBUG=1              # compile with debug flags (overrides optimisation)
#   make clean
# -------------------------------------------------------------------------
